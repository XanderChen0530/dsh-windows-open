#!/usr/bin/env python3
"""No shell: convert only PowerShell's script operand before command arguments."""
import glob
import os
import socket
import stat
import subprocess
import sys


def wslpath(mode, value):
    result = subprocess.run(['/usr/bin/wslpath', mode, value], check=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, timeout=3)
    path = result.stdout.rstrip('\r\n')
    if not path or '\n' in path or '\r' in path or '\0' in path:
        raise ValueError('wslpath returned an invalid path')
    return path


def interop_socket():
    candidates = [os.environ.get('WSL_INTEROP'), '/run/WSL/1_interop']
    candidates.extend(sorted(glob.glob('/run/WSL/*_interop')))
    for path in candidates:
        if not path:
            continue
        try:
            if not stat.S_ISSOCK(os.stat(path).st_mode):
                continue
            # A stale bound socket still passes stat; require a live listener.
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.2)
                probe.connect(path)
            return path
        except OSError:
            pass
    raise RuntimeError('no valid WSL interop socket')


def script_args(args):
    # Known options with operands must consume their values, even if a value
    # looks like -File. Stop as soon as a command or script body begins.
    operands = {'-executionpolicy', '-ep', '-ex', '-windowstyle', '-w',
                '-inputformat', '-inp', '-outputformat', '-o',
                '-configurationname', '-version', '-v'}
    index = 0
    while index < len(args):
        arg = args[index].lower()
        command = (arg in {'-c', '-ec', '-e', '-cwa', '--', '-'}
                   or (len(arg) >= 3 and '-command'.startswith(arg))
                   or (len(arg) >= 3 and '-encodedcommand'.startswith(arg))
                   or arg == '-commandwithargs')
        if command or not arg.startswith('-'):
            break
        if len(arg) >= 2 and '-file'.startswith(arg):
            if index + 1 >= len(args):
                raise ValueError('-File requires a script path')
            if args[index + 1].startswith('/'):
                args[index + 1] = wslpath('-w', args[index + 1])
            break
        index += 2 if arg in operands else 1
    return args


def main():
    try:
        os.environ['WSL_INTEROP'] = interop_socket()
        executable = wslpath('-u', r'C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe')
        if not executable.startswith('/'):
            raise ValueError('Windows executable did not resolve to an absolute path')
        args = script_args(sys.argv[1:])
        os.execv(executable, [executable, *args])
    except Exception as error:
        print('dsh-windows-open powershell: ' + str(error), file=sys.stderr)
        return 127
    return 127


if __name__ == '__main__':
    sys.exit(main())
