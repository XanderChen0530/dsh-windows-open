#!/usr/bin/env python3
"""WSL-only argv-preserving adapter for the native workspace opener."""
import glob
import os
import socket
import stat
import subprocess
import sys


def wslpath(mode, value):
    result = subprocess.run(['/usr/bin/wslpath', mode, value], check=True,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, timeout=3)
    path = result.stdout.rstrip('\r\n')
    if not path or '\n' in path or '\r' in path or '\0' in path:
        raise ValueError('wslpath returned an invalid path')
    return path


def interop_socket():
    candidates = [os.environ.get('WSL_INTEROP'), '/run/WSL/1_interop']
    candidates.extend(sorted(glob.glob('/run/WSL/*_interop')))
    for path in candidates:
        if not path:
            continue
        try:
            if not stat.S_ISSOCK(os.stat(path).st_mode):
                continue
            # A stale bound socket still passes stat; require a live listener.
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.2)
                probe.connect(path)
            return path
        except OSError:
            pass
    raise RuntimeError('no valid WSL interop socket')


def main():
    try:
        # This process only: never mutate the Host's global WSL_INTEROP.
        os.environ['WSL_INTEROP'] = interop_socket()
        executable = wslpath('-u', r'C:\Windows\explorer.exe')
        if not executable.startswith('/'):
            raise ValueError('Windows executable did not resolve to an absolute path')
        os.execv(executable, [executable, *sys.argv[1:]])
    except Exception as error:
        print('dsh-windows-open explorer: ' + str(error), file=sys.stderr)
        # Native opener treats explorer exit 1 as success; failures must be 127.
        return 127
    return 127


if __name__ == '__main__':
    sys.exit(main())
